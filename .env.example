# Copy to .env and fill in. docker compose reads it automatically.

# Required for Tier-3 diagnoses (free key: https://console.groq.com).
# Without it the gate still runs; FULL investigations report "no agent configured".
GROQ_API_KEY=
# Groq model of the Tier-3 agent; why the default was chosen is in ADR-011.
# DEPLOYD_GROQ_MODEL=openai/gpt-oss-120b

# Optional — the defaults below match docker-compose.yml / local runs.
# Chroma server; leave unset to use the embedded store in data/chroma.
# CHROMA_HOST=chroma
# CHROMA_PORT=8000

# Live UI → API address (server side) and as seen from the browser (graph panel).
# DEPLOYD_API_URL=http://localhost:8000
# DEPLOYD_PUBLIC_API_URL=http://localhost:8000
